# Butane config for Flatcar, rendered by Terraform, applied by Ignition on the VM's first boot.
# Everything the host is: an SSH key, the data disk, three files under /opt/orca (/etc is noexec on Flatcar),
# Docker's data root on the data disk, two units. Nothing else is ever written to it.
variant: flatcar
version: 1.0.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ${ssh_key}

storage:
  filesystems:
    # The data disk. Created blank the first time, reused as is after that (wipe_filesystem: false).
    - device: ${data_device}
      format: ext4
      label: orca
      wipe_filesystem: false
      path: /var/lib/orca
      with_mount_unit: true
  links:
    # /home/orca on the host is the same path as in the container, so a project's bind mounts line up.
    - path: /home/orca
      target: /var/lib/orca/home
      hard: false
  files:
    - path: /opt/orca/compose.yaml
      mode: 0644
      contents:
        inline: |
          ${indent(10, compose)}
    - path: /opt/orca/render-env
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          # Writes /var/lib/orca/env, the file the stack starts from. Runs on the VM, before any container exists.
          # Secret Manager holds one line, a 1Password service-account token. The VM reads it with its own GCP
          # identity, then op reads the note `orca-host` from the vault that token is scoped to and resolves its
          # {{ op:// }} references. Rotate a token in 1Password, restart this unit: that is the whole point.
          # op runs from its own image — Flatcar installs nothing — and the token stays here, out of the container.
          # Retries until the secret has a version: `make secret` may come after `make apply`.
          set -eu
          secret="projects/${project}/secrets/orca-host-${name}-op-token/versions/latest"
          note="op://${op_vault}/orca-host/notesPlain"
          # a pipeline's status is jq's, which is happy with an empty curl: test the values, not the commands
          while :; do
            access=$(curl -sf -H 'Metadata-Flavor: Google' \
              'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
              | jq -r '.access_token // empty')
            data=$(curl -sf -H "Authorization: Bearer $access" \
              "https://secretmanager.googleapis.com/v1/$secret:access" | jq -r '.payload.data // empty')
            [ -n "$data" ] && break
            echo "no version of $secret yet, retrying in 15s"
            sleep 15
          done
          # a token pasted into the console by hand may carry a newline; op wants the value alone
          OP_SERVICE_ACCOUNT_TOKEN=$(echo "$data" | base64 -d | tr -d '\r\n')
          export OP_SERVICE_ACCOUNT_TOKEN
          op() { docker run --rm -i -e OP_SERVICE_ACCOUNT_TOKEN 1password/op:2.39.0 op "$@"; }
          # `sh` has no pipefail: hold the result, write nothing rather than half a file. Failing is the point —
          # the stack must not come up on the env file of the last boot. `make secret` is the way back.
          rendered=$(op read "$note" | op inject)
          [ -n "$rendered" ] || { echo "$note rendered empty: expired token, or an item it cannot read"; exit 1; }
          umask 077
          printf '%s\n' "$rendered" > /var/lib/orca/env.tmp
          mv /var/lib/orca/env.tmp /var/lib/orca/env
    - path: /opt/orca/up
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          # Starts, or updates, the stack. Compose runs from the docker:cli image: Flatcar ships none.
          # Both images are public — the docker:cli one, and ORCA_IMAGE: no registry login here.
          set -eu
          exec docker run --rm \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v /opt/orca:/opt/orca:ro \
            -v /var/lib/orca:/var/lib/orca \
            -e TS_HOSTNAME -e ORCA_DATA -e ORCA_IMAGE -e ORCA_ENV_FILE \
            -w /opt/orca docker:29.8.1-cli \
            docker compose --env-file /var/lib/orca/env up -d --pull always --remove-orphans
    # Docker's data root on the data disk: images, build cache and the volumes of project stacks survive a rebuild,
    # and the boot disk is Flatcar only.
    - path: /etc/docker/daemon.json
      mode: 0644
      contents:
        inline: |
          {"data-root": "/var/lib/orca/docker"}

systemd:
  units:
    # Docker's data root is on the data disk: start after it is mounted.
    - name: docker.service
      dropins:
        - name: 10-data-root.conf
          contents: |
            [Unit]
            RequiresMountsFor=/var/lib/orca
    - name: orca-env.service
      enabled: true
      contents: |
        [Unit]
        Description=orca-host: render the env file from 1Password
        # `op` runs from an image, so this unit needs Docker as much as orca.service does.
        After=network-online.target docker.service
        Wants=network-online.target
        Requires=docker.service
        RequiresMountsFor=/var/lib/orca

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/opt/orca/render-env
        StandardOutput=journal+console
        StandardError=journal+console

        [Install]
        WantedBy=multi-user.target
    - name: orca.service
      enabled: true
      contents: |
        [Unit]
        Description=orca-host: the compose stack
        After=docker.service orca-env.service
        Requires=docker.service orca-env.service
        RequiresMountsFor=/var/lib/orca

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        Environment=TS_HOSTNAME=${name} ORCA_DATA=/var/lib/orca ORCA_IMAGE=${orca_image} ORCA_ENV_FILE=/var/lib/orca/env
        ExecStart=/opt/orca/up
        ExecStartPost=-/usr/bin/docker image prune -f
        StandardOutput=journal+console
        StandardError=journal+console

        [Install]
        WantedBy=multi-user.target
    # A merge to main publishes a new image under the tag this host follows, and nothing on the VM would know.
    # The check is the redeploy: `/opt/orca/up` is `--pull always`, and compose recreates a container only when
    # the digest it pulled differs from the running one. A tick with nothing new is a manifest request and no more.
    # Restarting orca.service rather than calling `up` keeps the environment and the image prune in one place.
    # This ends live terminals when it does fire, which is the point of following a tag: see architecture.md.
    - name: orca-update.service
      contents: |
        [Unit]
        Description=orca-host: redeploy when a new image is published under the tag this host follows
        After=docker.service orca.service
        Requires=docker.service

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl restart orca.service
        StandardOutput=journal+console
        StandardError=journal+console
    - name: orca-update.timer
      enabled: true
      contents: |
        [Unit]
        Description=orca-host: check for a new image every 5 minutes

        [Timer]
        OnBootSec=5min
        OnUnitActiveSec=5min

        [Install]
        WantedBy=timers.target
