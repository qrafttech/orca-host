# The body of the 1Password Secure Note `orca-host-tfvars`; `make` writes it to terraform.tfvars (gitignored) when absent.
name           = "orca-host"
project        = "my-gcp-project"
zone           = "europe-west9-b"
ssh_public_key = "ssh-ed25519 AAAA... me@laptop"
