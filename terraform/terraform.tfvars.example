# The body of the 1Password Secure Note `orca-host-tfvars`; `make` writes it to terraform.tfvars (gitignored) when absent.
name           = "orca-host"
project        = "my-gcp-project"
zone           = "europe-west9-b"
op_vault       = "Agents"   # the 1Password vault the host reads, through its service account
ssh_public_key = "ssh-ed25519 AAAA... me@laptop"
# machine_type = "e2-standard-4"
# data_disk_gb = 50
# orca_image   = "ghcr.io/qrafttech/orca-host:main"
