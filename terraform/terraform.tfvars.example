# Copy to terraform/terraform.tfvars (gitignored), or keep it in your own repository and point TFVARS at it. No secret.
name           = "orca-host"
project        = "my-gcp-project"
zone           = "europe-west9-b"
op_vault       = "AI Agents"   # the 1Password vault the host reads, through its service account
ssh_public_key = "ssh-ed25519 AAAA... me@laptop"
