# Copy to terraform/gcp/terraform.tfvars (gitignored), or keep it in your own repository and point TFVARS at it. No secret.
name           = "orca-host"
project        = "my-gcp-project"
zone           = "europe-west9-b"
op_vault       = "AI Agents"   # the 1Password vault the host reads, through its service account
ssh_public_key = "ssh-ed25519 AAAA... me@laptop"
# machine_type = "e2-standard-4"
# data_disk_gb = 50
# data_disk_zones = ["europe-west9-a", "europe-west9-b"]   # the data disk's two replicas: zone is one of them
# orca_image   = "ghcr.io/qrafttech/orca-host:main"
